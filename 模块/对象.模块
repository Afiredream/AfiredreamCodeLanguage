// 对象模块
//
// 提供以下导出函数
//
// 读取文件(路径)：获取文件里的 JSON 对象
// 写入文件(路径, 对象)：把对象以缩进两格的样子写进文件
// 写入紧凑(路径, 对象)：把对象写进文件，不带缩进与多余空白
// 转文本(对象)：获取对象的 JSON 文本，缩进两格，中文原样保留
// 转紧凑(对象)：获取对象的 JSON 文本，不带缩进与多余空白
// 解析(文本)：获取 JSON 文本对应的对象，空文本得到空对象
// 取(对象, 键)：获取对象里键对应的值，没有该键时为空文本
// 设(对象, 键, 值)：获取加上或改写该键后的新对象
// 删(对象, 键)：获取去掉该键后的新对象
// 有(对象, 键)：判断对象里是否有该键
// 空白(对象)：判断对象是否没有任何键
// 键列表(对象)：获取对象全部键组成的数组
// 值列表(对象)：获取对象全部值组成的数组
// 项数(对象)：获取对象里键的个数
//
// 以上注释不可修改

// 内部辅助（不导出）

文本:读取原文(文本:路径) {
    变量 文件:f = open(路径, "r", encoding="utf-8")
    变量 文本:内容 = f.read()
    f.close()
    返回 内容
}

真假:写回原文(文本:路径, 文本:内容) {
    变量 文件:f = open(路径, "w", encoding="utf-8")
    f.write(内容)
    f.close()
    返回 真
}

// 读取与写入对象文件

导出 读取文件(文本:路径) {
    路径是文件(路径) == 假 && 返回 {}
    变量 文本:原文 = 读取原文(路径)
    原文 == "" && 返回 {}
    返回 json.loads(原文)
}

导出 写入文件(文本:路径, 对象:内容) {
    变量 文本:原文 = json.dumps(内容, ensure_ascii=False, indent=2)
    返回 写回原文(路径, 原文)
}

导出 写入紧凑(文本:路径, 对象:内容) {
    变量 文本:原文 = json.dumps(内容, ensure_ascii=False)
    返回 写回原文(路径, 原文)
}

// 与文本互转

导出 转文本(对象:内容) {
    返回 json.dumps(内容, ensure_ascii=False, indent=2)
}

导出 转紧凑(对象:内容) {
    返回 json.dumps(内容, ensure_ascii=False)
}

导出 解析(文本:原文) {
    原文.strip() == "" && 返回 {}
    返回 json.loads(原文)
}

// 取值与设值

导出 取(对象:内容, 文本:键) {
    返回 内容.get(键, "")
}

导出 设(对象:内容, 文本:键, 任意:值) {
    变量 对象:结果 = dict(内容)
    结果[键] = 值
    返回 结果
}

导出 删(对象:内容, 文本:键) {
    变量 对象:结果 = dict(内容)
    结果.pop(键, None)
    返回 结果
}

// 判断

导出 真假:有(对象:内容, 文本:键) {
    返回 键 in 内容
}

导出 真假:空白(对象:内容) {
    返回 len(内容) == 0
}

// 枚举

导出 数组:键列表(对象:内容) {
    返回 list(内容.keys())
}

导出 数组:值列表(对象:内容) {
    返回 list(内容.values())
}

导出 数字:项数(对象:内容) {
    返回 len(内容)
}
