
# 对象模块
#
# 约定：
#   · 对象就是 JSON 风格的数据：文本、数字、列表、字典
#   · 每个函数的第一个参数都是要处理的对象
#   · 找不到的内容返回空文本，不中断程序
#
# 实现方式：直接使用 Python 的 json 标准库与字典方法，不额外新增底层函数。

# ── 读取与写入对象文件 ────────────────────────────────────

导出 读取文件(文本:a) {
    如果(not 路径是文件(a)) {
        终端输出("读取对象文件失败：文件不存在 -> " + a)
        返回 {}
    }
    变量 文本:原文 = 读取文本(a)
    如果(原文 == "") {
        返回 {}
    }
    返回 json.loads(原文)
}

导出 写入文件(文本:a, 对象:b) {
    变量 文本:内容 = json.dumps(b, ensure_ascii=False, indent=2)
    返回 写入文本(a, 内容)
}

导出 写入紧凑(文本:a, 对象:b) {
    变量 文本:内容 = json.dumps(b, ensure_ascii=False)
    返回 写入文本(a, 内容)
}

# ── 与文本互转 ────────────────────────────────────────────

导出 转文本(对象:a) {
    返回 json.dumps(a, ensure_ascii=False, indent=2)
}

导出 转紧凑(对象:a) {
    返回 json.dumps(a, ensure_ascii=False)
}

导出 解析(文本:a) {
    如果(a.strip() == "") {
        返回 {}
    }
    返回 json.loads(a)
}

# ── 取值与设值 ────────────────────────────────────────────

导出 取(对象:a, 文本:键) {
    返回 a.get(键, "")
}

导出 设(对象:a, 文本:键, x) {
    变量 对象:结果 = dict(a)
    结果[键] = x
    返回 结果
}

导出 删(对象:a, 文本:键) {
    变量 对象:结果 = dict(a)
    结果.pop(键, None)
    返回 结果
}

# ── 判断 ──────────────────────────────────────────────────

导出 有(对象:a, 文本:键) {
    如果(键 in a) {
        返回 真
    }
    返回 假
}

导出 状态:空白(对象:a) {
    // 检查对象是否没有任何键
    如果(len(a) == 0) {
        返回 真
    }
    返回 假
}

# ── 枚举 ──────────────────────────────────────────────────

导出 键列表(对象:a) {
    返回 list(a.keys())
}

导出 值列表(对象:a) {
    返回 list(a.values())
}

导出 项数(对象:a) {
    返回 len(a)
}

# ── 内部辅助 ──────────────────────────────────────────────

导出 读取文本(文本:a) {
    变量 文件:f = open(a, "r", encoding="utf-8")
    变量 文本:内容 = f.read()
    f.close()
    返回 内容
}

导出 写入文本(文本:a, 文本:b) {
    变量 文件:f = open(a, "w", encoding="utf-8")
    f.write(b)
    f.close()
    返回 真
}
