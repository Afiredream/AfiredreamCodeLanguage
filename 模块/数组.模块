// 数组模块
//
// 提供以下导出函数
//
// 长度(数组)：获取数组里元素的个数
// 索引(数组, 位置)：获取数组指定位置上的元素，位置从 1 开始数
// 拼接(数组...)：获取把多个数组接在一起得到的新数组
// 切割(数组, 开始, 结束)：获取从开始到结束（含两端）之间的元素组成的新数组
// 截断(数组, 限定长度)：获取只保留开头若干个元素的新数组
// 范围(数组, 开始, 结束)：获取从开始到结束（含两端）之间的元素组成的新数组
// 片段(数组, 开始, 数量)：获取从开始起指定个数的元素组成的新数组
// 查找(数组, 目标)：获取目标第一次出现的位置，找不到为 0
// 包含(数组, 目标)：判断数组里是否含有目标
// 开头(数组, 目标)：判断数组的第一项是否为目标
// 结尾(数组, 目标)：判断数组的最后一项是否为目标
// 追加(数组, 项)：获取在数组末尾接上项得到的新数组
// 前置(数组, 项)：获取在数组开头接上项得到的新数组
// 删除(数组, 位置)：获取去掉指定位置上元素后的新数组
// 插入(数组, 位置, 项)：获取在指定位置插入项后的新数组
// 修改(数组, 位置, 项)：获取把指定位置上的元素换成项后的新数组
// 反转(数组)：获取元素顺序颠倒后的新数组
// 去重(数组)：获取去掉重复元素后的新数组
// 排序(数组)：获取从小到大排好序的新数组
// 首项(数组)：获取数组的第一个元素
// 末项(数组)：获取数组的最后一个元素
// 遍历(数组, 函数)：依次把元素交给函数处理，不收集结果
// 映射(数组, 函数)：获取把每个元素交给函数处理后得到的新数组
// 筛选(数组, 函数)：获取只保留函数认为为真的元素后的新数组
// 归并(数组, 函数, 初始)：获取从左到右把元素累积起来得到的结果
// 空白(数组)：判断数组是否没有任何元素
//
// 以上注释不可修改

// 基础函数

导出 数字:长度(数组:参数) {
    返回 len(参数)
}

导出 任意:索引(数组:参数, 数字:位置) {
    返回 参数[int(位置)]
}

导出 数组:拼接(数组:参数...) {
    变量 数组:结果 = []
    变量 数字:序号 = 0
    循环(序号 < len(参数)) {
        结果 = 结果 + 参数[序号]
        序号++
    }
    返回 结果
}

// 取元素与切割

导出 数组:切割(数组:参数, 数字:开始, 数字:结束) {
    变量 数组:结果 = []
    变量 数字:序号 = 开始
    循环(序号 <= 结束 and 序号 <= 长度(参数)) {
        结果 = 结果 + [索引(参数, 序号)]
        序号++
    }
    返回 结果
}

导出 数组:截断(数组:参数, 数字:限定长度) {
    返回 切割(参数, 1, 限定长度)
}

导出 数组:范围(数组:参数, 数字:开始, 数字:结束) {
    返回 切割(参数, 开始, 结束)
}

导出 数组:片段(数组:参数, 数字:开始, 数字:数量) {
    返回 切割(参数, 开始, 开始 + 数量 - 1)
}

// 查找

导出 数字:查找(数组:参数, 任意:目标) {
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        如果(索引(参数, 序号) == 目标) {
            返回 序号
        }
        序号++
    }
    返回 0
}

导出 真假:包含(数组:参数, 任意:目标) {
    返回 查找(参数, 目标) > 0
}

导出 真假:开头(数组:参数, 任意:目标) {
    长度(参数) == 0 && 返回 假
    返回 索引(参数, 1) == 目标
}

导出 真假:结尾(数组:参数, 任意:目标) {
    长度(参数) == 0 && 返回 假
    返回 索引(参数, 长度(参数)) == 目标
}

// 增删

导出 数组:追加(数组:参数, 任意:项) {
    返回 参数 + [项]
}

导出 数组:前置(数组:参数, 任意:项) {
    变量 数组:结果 = [项] + 参数
    返回 结果
}

导出 数组:删除(数组:参数, 数字:位置) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        如果(序号 != 位置) {
            结果 = 结果 + [索引(参数, 序号)]
        }
        序号++
    }
    返回 结果
}

导出 数组:插入(数组:参数, 数字:位置, 任意:项) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    位置 <= 1 && 结果 = 结果 + [项]
    循环(序号 <= 长度(参数)) {
        结果 = 结果 + [索引(参数, 序号)]
        序号 == 位置 - 1 && 结果 = 结果 + [项]
        序号++
    }
    返回 结果
}

导出 数组:修改(数组:参数, 数字:位置, 任意:项) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        如果(序号 == 位置) {
            结果 = 结果 + [项]
        } 否则 {
            结果 = 结果 + [索引(参数, 序号)]
        }
        序号++
    }
    返回 结果
}

// 变换

导出 数组:反转(数组:参数) {
    变量 数组:结果 = []
    变量 数字:序号 = 长度(参数)
    循环(序号 >= 1) {
        结果 = 结果 + [索引(参数, 序号)]
        序号--
    }
    返回 结果
}

导出 数组:去重(数组:参数) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        变量 任意:项 = 索引(参数, 序号)
        查找(结果, 项) == 0 && 结果 = 结果 + [项]
        序号++
    }
    返回 结果
}

导出 数组:排序(数组:参数) {
    变量 数组:结果 = 参数 + []
    变量 数字:总数 = 长度(结果)
    变量 数字:轮次 = 0
    循环(轮次 < 总数) {
        变量 数字:序号 = 1
        循环(序号 < 总数 - 轮次) {
            变量 任意:左 = 索引(结果, 序号)
            变量 任意:右 = 索引(结果, 序号 + 1)
            如果(左 > 右) {
                结果[序号 - 1] = 右
                结果[序号] = 左
            }
            序号++
        }
        轮次++
    }
    返回 结果
}

// 取值

导出 任意:首项(数组:参数) {
    返回 索引(参数, 1)
}

导出 任意:末项(数组:参数) {
    返回 索引(参数, 长度(参数))
}

// 遍历

导出 空白:遍历(数组:参数, 函数:f) {
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        f(索引(参数, 序号), 序号)
        序号++
    }
}

导出 数组:映射(数组:参数, 函数:f) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        结果 = 结果 + [f(索引(参数, 序号), 序号)]
        序号++
    }
    返回 结果
}

导出 数组:筛选(数组:参数, 函数:f) {
    变量 数组:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        变量 任意:项 = 索引(参数, 序号)
        f(项, 序号) == 真 && 结果 = 结果 + [项]
        序号++
    }
    返回 结果
}

导出 任意:归并(数组:参数, 函数:f, 任意:初始) {
    变量 任意:结果 = 初始
    变量 数字:序号 = 1
    循环(序号 <= 长度(参数)) {
        结果 = f(结果, 索引(参数, 序号))
        序号++
    }
    返回 结果
}

// 判断

导出 真假:空白(数组:参数) {
    返回 长度(参数) == 0
}
