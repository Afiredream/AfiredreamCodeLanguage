// 类型模块
//
// 用「结构」语法定义类。
//
// 写法：
//   结构 类名(类型:字段...) {
//       函数() {
//           返回 {字段: 字段...}      // 定义这个类的对象长什么样
//       }
//   }
//
// 结构名会自动注册为函数，调用它就得到一个新的对象。
// 本模块还提供几个通用的类型判断与转换方法。

// ── 类定义示例 ────────────────────────────────────────────

// 人：名字 + 年龄
导出 结构 人(文本:名字, 数字:年龄) {
    函数() {
        返回 {名字: 名字, 年龄: 年龄}
    }
}

// 点：x + y
导出 结构 点(数字:x, 数字:y) {
    函数() {
        返回 {x: x, y: y}
    }
}

// 尺寸：宽 + 高
导出 结构 尺寸(数字:宽, 数字:高) {
    函数() {
        返回 {宽: 宽, 高: 高}
    }
}

// 矩形：左上角 + 尺寸
导出 结构 矩形(对象:原点, 对象:大小) {
    函数() {
        返回 {原点: 原点, 大小: 大小}
    }
}

// ── 类型判断 ──────────────────────────────────────────────
//
// 语言没有开放的 type()，这里用各类型自身的特征来判断。

导出 状态:是文本(任意:值) {
    如果(是对象(值)) {
        返回 假
    }
    如果(是数组(值)) {
        返回 假
    }
    如果(是状态(值)) {
        返回 假
    }
    如果(是数字(值)) {
        返回 假
    }
    返回 真
}

导出 状态:是数字(任意:值) {
    // 数字与文本都不带括号和引号，用加法特征区分：
    // 数字能和自己相加得到数值，文本相加仍是拼接
    如果(是对象(值)) {
        返回 假
    }
    如果(是数组(值)) {
        返回 假
    }
    如果(是状态(值)) {
        返回 假
    }
    变量 文本:表示 = str(值)
    如果(len(表示) == 0) {
        返回 假
    }
    返回 是数字文本(表示)
}

导出 状态:是数字文本(文本:表示) {
    // 全是数字、小数点或负号，且至少有一个数字
    变量 数字:序号 = 1
    变量 状态:有点 = 假
    变量 数字:数字个数 = 0
    循环(序号 <= len(表示)) {
        变量 文本:字 = 表示[序号]
        如果(字 == ".") {
            如果(有点) {
                返回 假
            }
            有点 = 真
        } 否则 {
            如果(字 == "-") {
                如果(序号 != 1) {
                    返回 假
                }
            } 否则 {
                如果(字 >= "0" and 字 <= "9") {
                    数字个数++
                } 否则 {
                    返回 假
                }
            }
        }
        序号++
    }
    返回 数字个数 > 0
}

导出 状态:是状态(任意:值) {
    变量 文本:表示 = str(值)
    返回 表示 == "True" or 表示 == "False"
}

导出 状态:是数组(任意:值) {
    变量 文本:表示 = str(值)
    如果(len(表示) < 2) {
        返回 假
    }
    如果(表示[1] == "[") {
        返回 真
    }
    // 元组形如 (1, 2)
    如果(表示[1] == "(" and 表示[len(表示)] == ")") {
        返回 真
    }
    返回 假
}

导出 状态:是对象(任意:值) {
    变量 文本:表示 = str(值)
    如果(len(表示) < 2) {
        返回 假
    }
    返回 表示[1] == "{"
}

导出 状态:是空(任意:值) {
    如果(是状态(值)) {
        返回 假
    }
    如果(是数字(值)) {
        返回 假
    }
    如果(是对象(值)) {
        返回 len(值) == 0
    }
    如果(是数组(值)) {
        返回 len(值) == 0
    }
    返回 str(值) == "None" or len(值) == 0
}

// ── 类型转换 ──────────────────────────────────────────────

导出 文本:转文本(任意:值) {
    返回 str(值)
}

导出 数字:转数字(任意:值) {
    返回 数值(值)
}

// ── 辅助 ──────────────────────────────────────────────────

导出 文本:类型名(任意:值) {
    如果(是对象(值)) {
        返回 "对象"
    }
    如果(是数组(值)) {
        返回 "数组"
    }
    如果(是状态(值)) {
        返回 "状态"
    }
    如果(是数字(值)) {
        返回 "数字"
    }
    返回 "文本"
}
