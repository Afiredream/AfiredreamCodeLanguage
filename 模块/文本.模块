// 文本模块
//
// 提供以下导出函数
//
// 长短(文本)：获取文本的字符个数
// 大小(文本)：获取文本按 UTF-8 编码后的字节数
// 索引(文本, 位置)：获取文本指定位置上的字符
// 拼接(文本...)：获取把多个文本接在一起得到的文本
// 零值(文本)：判断文本是否为空
// 追加(文本, 内容)：获取在文本后面接上内容得到的文本
// 切割(文本, 开始, 结束)：获取从开始到结束（含两端）之间的文本
// 从前切割(文本, 长度)：获取文本开头指定长度的部分
// 从后切割(文本, 长度)：获取文本结尾指定长度的部分
// 开头匹配(文本, 前缀)：判断文本是否以指定的前缀开头
// 结尾匹配(文本, 后缀)：判断文本是否以指定的后缀结尾
// 查找(文本, 子串)：获取子串第一次出现的位置，找不到为 0
// 包含(文本, 子串)：判断文本里是否含有子串
// 分割(文本, 分隔)：获取按分隔符拆开后的各段
// 连接(数组, 分隔)：获取把各段用分隔符接起来的文本
// 字母大写(文本)：获取字母全部大写的文本
// 字母小写(文本)：获取字母全部小写的文本
// 驼峰命名(文本)：获取首字母大写、其余保持原样的文本
// 去除两端空白(文本)：获取去掉两端空白后的文本
// 替换(文本, 旧文本, 新文本)：获取把旧文本换成新文本后的文本
// 规范(文本)：获取连续空白压成一个空格、去掉两端空白后的文本
// 匹配(文本, 格式)：获取按正则格式匹配到的各段
//
// 以上注释不可修改

导入 数学 命名 数学

// 基础函数

导出 数字:长短(文本:参数) {
    返回 len(参数)
}

导出 数字:大小(文本:参数) {
    返回 len(参数.encode("utf-8"))
}

导出 文本:索引(文本:参数, 数字:位置) {
    返回 参数[int(位置)]
}

导出 文本:拼接(文本:参数...) {
    返回 "".join(参数)
}

// 判断与追加

导出 真假:零值(文本:参数) {
    返回 长短(参数) == 0
}

导出 文本:追加(文本:目标, 文本:内容) {
    返回 拼接(目标, 内容)
}

// 切割

导出 文本:切割(文本:内容, 数字:开始, 数字:结束) {
    变量 数字:数字结束 = 数学.取最小值(结束, 长短(内容))
    开始 > 数字结束 && 返回 ""
    变量 文本:结果 = ""
    变量 数字:位置 = 开始
    循环(位置 <= 数字结束) {
        结果 = 结果 + 索引(内容, 位置)
        位置++
    }
    返回 结果
}

导出 文本:从前切割(文本:内容, 数字:长度) {
    返回 切割(内容, 1, 长度)
}

导出 文本:从后切割(文本:内容, 数字:长度) {
    变量 数字:结束 = 长短(内容)
    变量 数字:开始 = 结束 - 长度 + 1
    返回 切割(内容, 开始, 结束)
}

// 匹配与查找

导出 真假:开头匹配(文本:内容, 文本:前缀) {
    变量 数字:前缀长度 = 长短(前缀)
    前缀长度 > 长短(内容) && 返回 假
    返回 从前切割(内容, 前缀长度) == 前缀
}

导出 真假:结尾匹配(文本:内容, 文本:后缀) {
    变量 数字:后缀长度 = 长短(后缀)
    后缀长度 > 长短(内容) && 返回 假
    返回 从后切割(内容, 后缀长度) == 后缀
}

导出 数字:查找(文本:内容, 文本:子串) {
    变量 数字:子串长度 = 长短(子串)
    变量 数字:文本长度 = 长短(内容)
    零值(子串) && 返回 0
    变量 数字:位置 = 1
    循环(位置 + 子串长度 - 1 <= 文本长度) {
        切割(内容, 位置, 位置 + 子串长度 - 1) == 子串 && 返回 位置
        位置++
    }
    返回 0
}

导出 真假:包含(文本:内容, 文本:子串) {
    返回 查找(内容, 子串) > 0
}

// 分割与连接

导出 数组:分割(文本:内容, 文本:分隔) {
    变量 数组:结果 = []
    变量 数字:分隔长 = 长短(分隔)
    变量 数字:文本长 = 长短(内容)
    变量 数字:当前位置 = 1
    变量 数字:开始 = 1
    循环(当前位置 + 分隔长 - 1 <= 文本长) {
        如果(切割(内容, 当前位置, 当前位置 + 分隔长 - 1) == 分隔) {
            结果 = 结果 + [切割(内容, 开始, 当前位置 - 1)]
            当前位置 = 当前位置 + 分隔长
            开始 = 当前位置
        } 否则 {
            当前位置++
        }
    }
    结果 = 结果 + [切割(内容, 开始, 文本长)]
    返回 结果
}

导出 文本:连接(数组:各项, 文本:分隔) {
    len(各项) == 0 && 返回 ""
    变量 文本:结果 = str(各项[0])
    变量 数字:序号 = 1
    循环(序号 < len(各项)) {
        结果 = 拼接(结果, 分隔, str(各项[序号]))
        序号++
    }
    返回 结果
}

// 大小写

导出 文本:字母大写(文本:内容) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长短(内容)) {
        变量 文本:字 = 索引(内容, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 97 and 码 <= 122) {
            结果 = 拼接(结果, chr(码 - 32))
        } 否则 {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:字母小写(文本:内容) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长短(内容)) {
        变量 文本:字 = 索引(内容, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 65 and 码 <= 90) {
            结果 = 拼接(结果, chr(码 + 32))
        } 否则 {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:驼峰命名(文本:内容) {
    零值(内容) && 返回 ""
    返回 拼接(字母大写(索引(内容, 1)), 切割(内容, 2, 长短(内容)))
}

// 清理与替换

导出 文本:去除两端空白(文本:内容) {
    变量 数字:左 = 1
    变量 数字:右 = 长短(内容)
    循环(左 <= 右 and 索引(内容, 左) == " ") {
        左++
    }
    循环(右 >= 左 and 索引(内容, 右) == " ") {
        右--
    }
    左 > 右 && 返回 ""
    返回 切割(内容, 左, 右)
}

导出 文本:替换(文本:内容, 文本:旧文本, 文本:新文本) {
    变量 文本:结果 = ""
    变量 数字:旧长 = 长短(旧文本)
    变量 数字:总长 = 长短(内容)
    零值(旧文本) && 返回 内容
    变量 数字:当前位置 = 1
    循环(当前位置 <= 总长) {
        如果(当前位置 + 旧长 - 1 <= 总长 and 切割(内容, 当前位置, 当前位置 + 旧长 - 1) == 旧文本) {
            结果 = 拼接(结果, 新文本)
            当前位置 = 当前位置 + 旧长
        } 否则 {
            结果 = 拼接(结果, 索引(内容, 当前位置))
            当前位置++
        }
    }
    返回 结果
}

导出 文本:规范(文本:内容) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    变量 状态:上次是空白 = 假
    循环(序号 <= 长短(内容)) {
        变量 文本:字 = 索引(内容, 序号)
        如果(字 == " " or 字 == "　") {
            如果(上次是空白 == 假 and 长短(结果) > 0) {
                结果 = 拼接(结果, " ")
            }
            上次是空白 = 真
        } 否则 {
            结果 = 拼接(结果, 字)
            上次是空白 = 假
        }
        序号++
    }
    返回 去除两端空白(结果)
}

// 正则匹配

导出 数组:匹配(文本:内容, 文本:格式) {
    返回 正则查找(内容, 格式)
}
