// 配置模块（INI）
//
// 提供以下导出函数
//
// 读取(路径)：获取配置文件里的配置对象
// 写入(路径, 对象)：把配置对象写进文件
// 解析(文本)：获取 INI 文本对应的配置对象，形如 {节: {键: 值}}
// 转文本(对象)：获取配置对象对应的 INI 文本
// 取段(对象, 节)：获取某一节 {键: 值}，没有该节时为空对象
// 取(对象, 节, 键, 缺省)：获取某一节里键对应的值，找不到时给缺省
// 取数字(对象, 节, 键, 缺省)：获取某一节里键对应的数字，找不到时给缺省
// 取真假(对象, 节, 键)：判断某一节里键对应的值是否为真
// 设(对象, 节, 键, 值)：获取加上或改写该键后的新配置对象
// 删键(对象, 节, 键)：获取去掉该键后的新配置对象
// 删段(对象, 节)：获取去掉该节后的新配置对象
// 有段(对象, 节)：判断配置里是否有该节
// 有键(对象, 节, 键)：判断某一节里是否有该键
// 段列表(对象)：获取全部节名组成的数组
// 键列表(对象, 节)：获取某一节里全部键名组成的数组
//
// 以上注释不可修改

// 内部辅助（不导出）

文本:读取原文(文本:路径) {
    变量 文件:f = open(路径, "r", encoding="utf-8")
    变量 文本:内容 = f.read()
    f.close()
    返回 内容
}

真假:写回原文(文本:路径, 文本:内容) {
    变量 文件:f = open(路径, "w", encoding="utf-8")
    f.write(内容)
    f.close()
    返回 真
}

对象:新建解析器() {
    变量 对象:解析器 = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        allow_no_value=True,
        comment_prefixes=["#", ";"],
        inline_comment_prefixes=None,
        empty_lines_in_values=False
    )
    解析器.optionxform = str
    返回 解析器
}

对象:段内容(对象:解析器, 文本:节) {
    变量 对象:内容 = {}
    变量 数组:键名 = 解析器.options(节)
    变量 数字:序号 = 0
    循环(序号 < len(键名)) {
        变量 文本:键 = 键名[序号]
        如果(键 != "DEFAULT") {
            变量 文本:值 = 解析器.get(节, 键)
            如果(值 == None) {
                值 = ""
            }
            内容[键] = 值
        }
        序号++
    }
    返回 内容
}

对象:复制对象(对象:配置) {
    变量 对象:结果 = {}
    变量 数组:节名 = list(配置.keys())
    变量 数字:序号 = 0
    循环(序号 < len(节名)) {
        结果[节名[序号]] = dict(配置[节名[序号]])
        序号++
    }
    返回 结果
}

// 读取与写入

导出 读取(文本:路径) {
    路径是文件(路径) == 假 && 返回 {}
    返回 解析(读取原文(路径))
}

导出 写入(文本:路径, 对象:配置) {
    返回 写回原文(路径, 转文本(配置))
}

// 与文本互转

导出 解析(文本:原文) {
    变量 对象:解析器 = 新建解析器()
    如果(原文.startswith("﻿")) {
        原文 = 原文[1:]
    }
    解析器.read_string(原文)
    变量 对象:结果 = {}
    变量 数字:序号 = 0
    变量 数组:节名 = 解析器.sections()
    循环(序号 < len(节名)) {
        变量 文本:节 = 节名[序号]
        结果[节] = 段内容(解析器, 节)
        序号++
    }
    返回 结果
}

导出 转文本(对象:配置) {
    变量 数组:行 = []
    变量 数组:节名 = list(配置.keys())
    变量 数字:序号 = 0
    循环(序号 < len(节名)) {
        变量 文本:节 = 节名[序号]
        行 = 行 + ["[" + 节 + "]"]
        变量 数组:键名 = list(配置[节].keys())
        变量 数字:键序 = 0
        循环(键序 < len(键名)) {
            行 = 行 + [键名[键序] + " = " + str(配置[节][键名[键序]])]
            键序++
        }
        行 = 行 + [""]
        序号++
    }
    返回 chr(10).join(行)
}

// 取值

导出 对象:取段(对象:配置, 文本:节) {
    返回 配置.get(节, {})
}

导出 文本:取(对象:配置, 文本:节, 文本:键, 文本:缺省) {
    配置.get(节, None) == None && 返回 缺省
    返回 配置[节].get(键, 缺省)
}

导出 数字:取数字(对象:配置, 文本:节, 文本:键, 数字:缺省) {
    变量 文本:值 = 取(配置, 节, 键, "")
    值 == "" && 返回 缺省
    返回 int(值)
}

导出 真假:取真假(对象:配置, 文本:节, 文本:键) {
    变量 文本:值 = 取(配置, 节, 键, "假").strip().lower()
    返回 值 in ["真", "是", "1", "true", "yes", "on"]
}

// 修改

导出 对象:设(对象:配置, 文本:节, 文本:键, 文本:值) {
    变量 对象:结果 = 复制对象(配置)
    如果(结果.get(节, None) == None) {
        结果[节] = {}
    }
    结果[节][键] = 值
    返回 结果
}

导出 对象:删键(对象:配置, 文本:节, 文本:键) {
    变量 对象:结果 = 复制对象(配置)
    如果(结果.get(节, None) != None) {
        结果[节].pop(键, None)
    }
    返回 结果
}

导出 对象:删段(对象:配置, 文本:节) {
    变量 对象:结果 = 复制对象(配置)
    结果.pop(节, None)
    返回 结果
}

// 判断与枚举

导出 真假:有段(对象:配置, 文本:节) {
    返回 配置.get(节, None) != None
}

导出 真假:有键(对象:配置, 文本:节, 文本:键) {
    配置.get(节, None) == None && 返回 假
    返回 配置[节].get(键, None) != None
}

导出 数组:段列表(对象:配置) {
    返回 list(配置.keys())
}

导出 数组:键列表(对象:配置, 文本:节) {
    返回 list(配置.get(节, {}).keys())
}
