// 路径模块
//
// 提供以下导出函数
//
// 拼接(路径, 片段)：获取把片段接到路径后面得到的路径
// 目录(路径)：获取路径所在的目录
// 上级(路径)：获取路径的上一级目录
// 名称(路径)：获取路径最后的名字
// 文件名(路径)：获取名称去掉拓展后的部分
// 拓展(路径)：获取路径的拓展名，没有拓展时为空文本
// 替换拓展(路径, 新拓展)：获取换了拓展名的路径
// 规范(路径)：获取去掉多余斜杠、. 与 .. 后的路径
// 绝对(路径)：获取目录开头的路径，以 / 开头为真
// 存在(路径)：判断路径是否存在
// 是文件(路径)：判断路径是否为文件
// 是目录(路径)：判断路径是否为目录
// 分段(路径)：获取路径按 / 拆开的各段
// 层级(路径)：获取路径的层数
// 大小(路径)：获取路径对应文件的大小
//
// 以上注释不可修改

// 内部辅助（不导出）

文本:去掉首尾斜杠(文本:路径) {
    返回 路径.strip("/")
}

数字:最后点位置(文本:名字) {
    返回 名字.rfind(".")
}

// 拼接

导出 文本:拼接(文本:基路径, 文本:片段) {
    片段 == "" && 返回 基路径
    基路径 == "" && 返回 片段
    基路径.endswith("/") && 返回 基路径 + 片段
    返回 基路径 + "/" + 片段
}

// 目录

导出 文本:目录(文本:路径) {
    变量 数组:各段 = 去掉首尾斜杠(路径).split("/")
    len(各段) <= 1 && 返回 ""
    变量 数组:前面 = 各段[:len(各段) - 1]
    返回 "/".join(前面)
}

导出 文本:上级(文本:路径) {
    返回 目录(路径)
}

// 名称

导出 文本:名称(文本:路径) {
    变量 数组:各段 = 去掉首尾斜杠(路径).split("/")
    返回 各段[len(各段) - 1]
}

导出 文本:文件名(文本:路径) {
    变量 文本:最后 = 名称(路径)
    变量 数字:位置 = 最后点位置(最后)
    位置 <= 0 && 返回 最后
    返回 最后[:位置]
}

// 拓展

导出 文本:拓展(文本:路径) {
    变量 文本:最后 = 名称(路径)
    变量 数字:位置 = 最后点位置(最后)
    位置 <= 0 && 返回 ""
    返回 最后[位置 + 1:]
}

导出 文本:替换拓展(文本:路径, 文本:新拓展) {
    变量 文本:最后 = 名称(路径)
    变量 数字:位置 = 最后点位置(最后)
    位置 <= 0 && 返回 拼接(路径, "." + 新拓展)
    变量 文本:新名 = 最后[:位置] + "." + 新拓展
    返回 拼接(目录(路径), 新名)
}

// 规范

导出 文本:规范(文本:路径) {
    变量 数组:各段 = 路径.split("/")
    变量 数组:结果 = []
    变量 数字:序号 = 0
    变量 数字:个数 = len(各段)
    循环(序号 < 个数) {
        变量 文本:段 = 各段[序号]
        如果(段 == "..") {
            len(结果) > 0 && 结果 = 结果[:len(结果) - 1]
        } 否则 {
            如果(段 != "" and 段 != ".") {
                结果 = 结果 + [段]
            }
        }
        序号++
    }
    变量 文本:开头 = ""
    路径.startswith("/") && 开头 = "/"
    返回 开头 + "/".join(结果)
}

// 判断

导出 真假:绝对(文本:路径) {
    返回 路径.startswith("/")
}

导出 真假:存在(文本:路径) {
    返回 路径存在(路径)
}

导出 真假:是文件(文本:路径) {
    返回 路径是文件(路径)
}

导出 真假:是目录(文本:路径) {
    返回 路径是目录(路径)
}

// 拆分

导出 数组:分段(文本:路径) {
    变量 数组:全部 = 去掉首尾斜杠(路径).split("/")
    len(全部) == 1 && 全部[0] == "" && 返回 []
    返回 全部
}

导出 数字:层级(文本:路径) {
    返回 len(分段(路径))
}

// 大小

导出 数字:大小(文本:路径) {
    返回 路径大小(路径)
}
