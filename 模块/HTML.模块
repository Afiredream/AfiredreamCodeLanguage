// HTML 模块
//
// 提供以下导出函数
//
// 解析(文本)：获取 HTML 文本里全部元素组成的数组
// 文本(文本)：获取 HTML 文本里去掉标签后的全部文字
// 查找(文本, 标签)：获取 HTML 文本里指定标签的元素组成的数组
// 标签文本(文本, 标签)：获取 HTML 文本里指定标签里的文字
// 属性(文本, 标签, 属性名)：获取 HTML 文本里指定标签的属性值
// 转义(文本)：获取把 < > & 等符号换成 HTML 实体的文本
// 反转义(文本)：获取把 HTML 实体换回原有符号的文本
// 取标签(元素)：获取元素对象的标签名
// 取文本(元素)：获取元素对象里的全部文字
// 取属性表(元素)：获取元素对象的属性表
// 取属性值(元素, 属性名)：获取元素对象里指定属性的值
//
// 以上注释不可修改

// 解析

导出 数组:解析(文本:源) {
    返回 解析HTML文本(源)
}

导出 文本:文本(文本:源) {
    返回 提取HTML文本(源)
}

// 按标签查找

导出 数组:查找(文本:源, 文本:标签) {
    返回 查找HTML元素(源, 标签)
}

导出 文本:标签文本(文本:源, 文本:标签) {
    返回 提取HTML标签文本(源, 标签)
}

导出 文本:属性(文本:源, 文本:标签, 文本:属性名) {
    返回 提取HTML属性(源, 标签, 属性名)
}

// 转义

导出 文本:转义(文本:源) {
    返回 转义HTML文本(源)
}

导出 文本:反转义(文本:源) {
    返回 反转义HTML文本(源)
}

// 从元素对象里取值

导出 文本:取标签(对象:元素) {
    返回 对象取(元素, "标签")
}

导出 文本:取文本(对象:元素) {
    返回 对象取(元素, "全部文本")
}

导出 对象:取属性表(对象:元素) {
    返回 对象取(元素, "属性")
}

导出 文本:取属性值(对象:元素, 文本:属性名) {
    返回 对象取(对象取(元素, "属性"), 属性名)
}
