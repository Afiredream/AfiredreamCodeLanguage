// 数学模块
//
// 提供以下导出函数
//
// 自增(数字, 步长 = 1)：数字自增，可自定义步长
// 自减(数字, 步长 = 1)：数字自减，可自定义步长
//
// 整数(数字)：判断数字是否为整数
// 负数(数字)：判断数字是否为负数
// 正数(数字)：判断数字是否为正数
// 零值(数字)：判断数字是否为零值
// 自然数(数字)：判断数字是否为自然数
//
// 正负(数字)：获取数字的正负符号
//
// 相等(数字...)：判断多个数字是否相等
// 求和(数字...)：获取多个数字的总和
// 求积(数字...)：获取多个数字的总积
//
// 取倒数(数字)：获取数字倒数
// 取相反数(数字)：获取数字相反数
// 取绝对值(数字)：获取数字绝对值
// 向下取整(数字)：获取最大的小于数字的整数
// 向上取整(数字)：获取最小的大于数字的整数
// 向零取整(数字)：获取数字原点方向的第一个整数
// 整数部分(数字)：获取数字整数部分
// 小数部分(数字)：获取数字小数部分
// 四舍五入(数字, 位数 = 0)：获取数字四舍五入后保留指定位数的结果
//
// 幂方(数字, 次数)：获取数字指数次幂
// 平方(数字)：获取数字平方
// 立方(数字)：获取数字立方
// 开方(数字, 次数)：获取数字指定次方根的结果
// 开平方(数字)：获取数字的平方根
// 开立方(数字)：获取数字的立方根
//
// 对数(数字, 底 = 10)：获取数字以指定底为底的对数
// 自然对数(数字)：获取数字以自然常数为底的对数
// 对数十(数字)：获取数字以十为底的对数
// 取最小值(数字...)：获取多个数字中最小的数字
// 取最大值(数字...)：获取多个数字中最大的数字
//
// 众数(数字...)：获取数组的众数
// 极差(数字...)：获取数组的极差
// 方差(数字...)：获取数组的方差
// 平均值(数字...)：获取多个数字的平均值
// 中位数(数字...)：获取数组的中位数
// 标准差(数字...)：获取数组的标准差
//
// 阶乘(数字)：获取数字的阶乘
// 区间求和(开始, 结束)：获取从开始到结束所有整数的和
//
// 斐波那契(数字)：获取斐波那契数列指定序号上的数字
// 等差数列(首项, 公差, 序号)：获取等差数列指定序号上的数字
// 等比数列(首项, 公比, 序号)：获取等比数列指定序号上的数字
//
// 小数点向右移(数字, 位数 = 1)：获取数字小数点向右移动指定位数后的数字
// 小数点向左移(数字, 位数 = 1)：获取数字小数点向左移动指定位数后的数字
// 三角形求斜边(直角边1, 直角边2)：获取直角三角形两条直角边对应的斜边
//
// 以上注释不可修改

导入 数组 命名 数组

// 供模块内部使用，不导出的辅助函数

数字:连乘(数字:底, 数字:次数) {
    零值(次数) && 返回 1
    变量 数字:结果 = 1
    变量 数字:序号 = 1
    循环(序号 <= 次数) {
        结果 = 结果 * 底
        序号++
    }
    返回 结果
}

数字:二分求指数(数字:底, 数字:目标) {
    变量 数字:低 = -1024
    变量 数字:高 = 1024
    变量 数字:序号 = 1
    循环(序号 <= 60) {
        变量 数字:和 = 低 + 高
        变量 数字:中 = 和 / 2
        如果(连乘(底, 中) > 目标) {
            高 = 中
        } 否则 {
            低 = 中
        }
        序号++
    }
    变量 数字:结果 = 低 + 高
    返回 结果 / 2
}

数字:连加(列表:数组) {
    变量 数字:结果 = 0
    变量 数字:序号 = 1
    变量 数字:个数 = 数组.长度(数组)
    循环(序号 <= 个数) {
        结果 = 结果 + 数组.索引(数组, 序号)
        序号++
    }
    返回 结果
}

数字:大者(列表:数组) {
    变量 数字:个数 = 数组.长度(数组)
    个数 == 0 && 返回 负无穷大
    变量 数字:结果 = 负无穷大
    变量 数字:序号 = 1
    循环(序号 <= 个数) {
        数组.索引(数组, 序号) > 结果 && 结果 = 数组.索引(数组, 序号)
        序号++
    }
    返回 结果
}

数字:小者(列表:数组) {
    变量 数字:个数 = 数组.长度(数组)
    个数 == 0 && 返回 正无穷大
    变量 数字:结果 = 正无穷大
    变量 数字:序号 = 1
    循环(序号 <= 个数) {
        数组.索引(数组, 序号) < 结果 && 结果 = 数组.索引(数组, 序号)
        序号++
    }
    返回 结果
}

// 增减

导出 数字:自增(数字:参数, 数字:步长 = 1) {
    返回 参数 + 步长
}

导出 数字:自减(数字:参数, 数字:步长 = 1) {
    返回 参数 - 步长
}

// 判断（返回真假）

导出 真假:整数(数字:参数) {
    返回 参数 % 1 == 0
}

导出 真假:负数(数字:参数) {
    返回 参数 < 0
}

导出 真假:正数(数字:参数) {
    返回 参数 > 0
}

导出 真假:零值(数字:参数) {
    返回 参数 == 0
}

导出 真假:自然数(数字:参数) {
    返回 参数 >= 0
}

导出 真假:相等(数字:参数...) {
    数组.空白(参数) && 返回 真
    常量 数字:首数 = 参数[1]
    对于 (参数, 位置, 元素) {
        元素 != 首数 && 返回 假
    }
    返回 真
}

// 正负与累加

导出 数字:正负(数字:参数) {
    正数(参数) && 返回 1
    负数(参数) && 返回 -1
    返回 0
}

导出 数字:求和(数字:参数...) {
    变量 数字:结果 = 0
    变量 数字:序号 = 0
    变量 数字:个数 = len(参数)
    循环(序号 < 个数) {
        结果 = 结果 + 参数[序号]
        序号++
    }
    返回 结果
}

导出 数字:求积(数字:参数...) {
    变量 数字:结果 = 1
    变量 数字:序号 = 0
    变量 数字:个数 = len(参数)
    循环(序号 < 个数) {
        结果 = 结果 * 参数[序号]
        序号++
    }
    返回 结果
}

// 倒数、相反数与取整

导出 数字:取倒数(数字:参数) {
    零值(参数) && 返回 0
    返回 1 / 参数
}

导出 数字:取相反数(数字:参数) {
    返回 0 - 参数
}

导出 数字:取绝对值(数字:参数) {
    自然数(参数) && 返回 参数
    返回 取相反数(参数)
}

导出 数字:向下取整(数字:参数) {
    整数(参数) && 返回 参数
    返回 参数 - 参数 % 1
}

导出 数字:向上取整(数字:参数) {
    整数(参数) && 返回 参数
    返回 参数|向下取整()|自增()
}

导出 数字:向零取整(数字:参数) {
    正数(参数) && 返回 向下取整(参数)
    负数(参数) && 返回 向上取整(参数)
    返回 参数
}

导出 数字:整数部分(数字:参数) {
    返回 向零取整(参数)
}

导出 数字:小数部分(数字:参数) {
    返回 参数 - 整数部分(参数)
}

导出 数字:四舍五入(数字:参数, 数字:位数 = 0) {
    变量 数字:放大值 = 小数点向右移(取绝对值(参数), 位数)
    变量 数字:向下 = 向下取整(放大值)
    变量 数字:小数 = 放大值 - 向下
    如果(小数 >= 0.5) {
        向下 = 向下 + 1
    }
    变量 数字:结果 = 向下 / 小数点向右移(1, 位数)
    返回 结果 * 正负(参数)
}

// 幂与方根

导出 数字:幂方(数字:参数, 数字:次数) {
    零值(次数) && 返回 1
    负数(次数) && 返回 取倒数(连乘(参数, 取相反数(次数)))
    返回 连乘(参数, 次数)
}

导出 数字:平方(数字:参数) {
    返回 参数 * 参数
}

导出 数字:立方(数字:参数) {
    返回 参数 * 参数 * 参数
}

导出 数字:开方(数字:参数, 数字:次数) {
    如果(次数 < 1) {
        返回 0
    }
    次数 == 1 && 返回 参数
    零值(参数) && 返回 0
    如果(参数 <= 1) {
        次数 == 2 && 返回 开平方(参数)
        次数 == 3 && 返回 开立方(参数)
    }
    变量 数字:低位 = 0
    变量 数字:高位 = 参数
    参数 < 1 && 高位 = 1
    变量 数字:序号 = 1
    循环(序号 <= 80) {
        变量 数字:和 = 低位 + 高位
        变量 数字:中 = 和 / 2
        如果(连乘(中, 次数) > 参数) {
            高位 = 中
        } 否则 {
            低位 = 中
        }
        序号++
    }
    变量 数字:边界和 = 低位 + 高位
    返回 边界和 / 2
}

导出 数字:开平方(数字:参数) {
    如果(负数(参数)) {
        返回 0
    }
    零值(参数) && 返回 0
    变量 数字:猜测 = 参数
    变量 数字:序号 = 1
    循环(序号 <= 30) {
        变量 数字:和 = 猜测 + 参数 / 猜测
        猜测 = 和 / 2
        序号++
    }
    返回 猜测
}

导出 数字:开立方(数字:参数) {
    零值(参数) && 返回 0
    变量 数字:正数 = 取绝对值(参数)
    变量 数字:低位 = 0
    变量 数字:高位 = 正数
    正数 < 1 && 高位 = 1
    变量 数字:序号 = 1
    循环(序号 <= 80) {
        变量 数字:和 = 低位 + 高位
        变量 数字:中 = 和 / 2
        如果(立方(中) > 正数) {
            高位 = 中
        } 否则 {
            低位 = 中
        }
        序号++
    }
    变量 数字:边界和 = 低位 + 高位
    变量 数字:结果 = 边界和 / 2
    负数(参数) && 返回 取相反数(结果)
    返回 结果
}

// 对数与极值

导出 数字:对数(数字:参数, 数字:底 = 10) {
    如果(参数 <= 0 or 底 <= 0 or 底 == 1) {
        返回 0
    }
    参数 == 1 && 返回 0
    返回 二分求指数(底, 参数)
}

导出 数字:自然对数(数字:参数) {
    返回 对数(参数, 2.718281828459045)
}

导出 数字:对数十(数字:参数) {
    返回 对数(参数, 10)
}

导出 数字:取最小值(数字:参数...) {
    数组.空白(参数) && 返回 正无穷大
    变量 数字:结果 = 参数[1]
    变量 数字:序号 = 2
    变量 数字:个数 = len(参数)
    循环(序号 <= 个数) {
        参数[序号 - 1] < 结果 && 结果 = 参数[序号 - 1]
        序号++
    }
    返回 结果
}

导出 数字:取最大值(数字:参数...) {
    数组.空白(参数) && 返回 负无穷大
    变量 数字:结果 = 参数[1]
    变量 数字:序号 = 2
    变量 数字:个数 = len(参数)
    循环(序号 <= 个数) {
        参数[序号 - 1] > 结果 && 结果 = 参数[序号 - 1]
        序号++
    }
    返回 结果
}

// 统计

导出 数字:平均值(数字:参数...) {
    零值(len(参数)) && 返回 0
    变量 数字:合计 = 0
    变量 数字:序号 = 0
    循环(序号 < len(参数)) {
        合计 = 合计 + 参数[序号]
        序号++
    }
    返回 合计 / len(参数)
}

导出 数字:中位数(数字:参数...) {
    零值(len(参数)) && 返回 0
    变量 列表:排好 = 数组.排序(参数)
    变量 数字:个数 = 数组.长度(排好)
    变量 数字:一半 = 个数 / 2
    变量 数字:中间 = 向下取整(一半)
    个数 % 2 == 1 && 返回 数组.索引(排好, 中间 + 1)
    变量 数字:前一个 = 数组.索引(排好, 中间)
    变量 数字:后一个 = 数组.索引(排好, 中间 + 1)
    变量 数字:中间和 = 前一个 + 后一个
    返回 中间和 / 2
}

导出 数字:众数(数字:参数...) {
    变量 数字:个数 = len(参数)
    零值(个数) && 返回 0
    变量 数字:最多 = 0
    变量 数字:结果 = 0
    变量 数字:序号 = 0
    循环(序号 < 个数) {
        变量 数字:当前 = 参数[序号]
        变量 数字:出现 = 0
        变量 数字:位置 = 0
        循环(位置 < 个数) {
            参数[位置] == 当前 && 出现++
            位置++
        }
        如果(出现 > 最多) {
            最多 = 出现
            结果 = 当前
        } 否则 {
            如果(出现 == 最多 and 当前 < 结果) {
                结果 = 当前
            }
        }
        序号++
    }
    返回 结果
}

导出 数字:极差(数字:参数...) {
    零值(len(参数)) && 返回 0
    变量 数字:最大 = 取最大值(参数...)
    变量 数字:最小 = 取最小值(参数...)
    返回 最大 - 最小
}

导出 数字:方差(数字:参数...) {
    变量 数字:个数 = len(参数)
    零值(个数) && 返回 0
    变量 数字:平均 = 平均值(参数...)
    变量 数字:合计平方 = 0
    变量 数字:序号 = 0
    循环(序号 < 个数) {
        变量 数字:差 = 参数[序号] - 平均
        合计平方 = 合计平方 + 平方(差)
        序号++
    }
    返回 合计平方 / 个数
}

导出 数字:标准差(数字:参数...) {
    变量 数字:方差值 = 方差(参数...)
    返回 开平方(方差值)
}

// 阶乘与区间

导出 数字:阶乘(数字:参数) {
    负数(参数) && 返回 1
    变量 数字:结果 = 1
    变量 数字:序号 = 2
    循环(序号 <= 参数) {
        结果 = 结果 * 序号
        序号++
    }
    返回 结果
}

导出 数字:区间求和(数字:开始, 数字:结束) {
    开始 > 结束 && 返回 0
    变量 数字:个数 = 结束 - 开始 + 1
    变量 数字:首尾和 = 开始 + 结束
    变量 数字:积 = 个数 * 首尾和
    返回 积 / 2
}

// 数列

导出 数字:斐波那契(数字:参数) {
    负数(参数) && 返回 0
    变量 数字:前前 = 0
    变量 数字:前 = 1
    变量 数字:序号 = 0
    循环(序号 < 参数) {
        变量 数字:当前 = 前前 + 前
        前前 = 前
        前 = 当前
        序号++
    }
    返回 前前
}

导出 数字:等差数列(数字:首项, 数字:公差, 数字:序号) {
    序号 < 1 && 返回 0
    变量 数字:步数 = 序号 - 1
    返回 首项 + 公差 * 步数
}

导出 数字:等比数列(数字:首项, 数字:公比, 数字:序号) {
    序号 < 1 && 返回 0
    变量 数字:步数 = 序号 - 1
    返回 首项 * 幂方(公比, 步数)
}

// 小数点移动与几何

导出 数字:小数点向右移(数字:参数, 数字:位数 = 1) {
    返回 参数 * 幂方(10, 位数)
}

导出 数字:小数点向左移(数字:参数, 数字:位数 = 1) {
    返回 参数 / 幂方(10, 位数)
}

导出 数字:三角形求斜边(数字:直角边1, 数字:直角边2) {
    变量 数字:平方和 = 平方(直角边1) + 平方(直角边2)
    返回 开平方(平方和)
}
