// YAML 模块
//
// 提供以下导出函数
//
// 解析(文本)：获取 YAML 文本对应的配置对象
// 转文本(对象)：获取配置对象对应的 YAML 文本，缩进两格
// 转紧凑(对象)：获取配置对象对应的 YAML 文本，缩进四格
// 取(对象, 键)：获取配置里键对应的值，没有该键时为空文本
// 取段(对象, 键)：获取配置里某一节 {键: 值}
// 取数字(对象, 键, 缺省)：获取配置里键对应的数字，找不到时给缺省
// 取真假(对象, 键)：判断配置里键对应的值是否为真
// 设(对象, 键, 值)：获取加上或改写该键后的新配置对象
// 删(对象, 键)：获取去掉该键后的新配置对象
// 有(对象, 键)：判断配置里是否有该键
// 键列表(对象)：获取全部键组成的数组
// 项数(对象)：获取键的个数
//
// 以上注释不可修改

// 解析与生成

导出 解析(文本:源) {
    返回 解析YAML文本(源)
}

导出 文本:转文本(对象:配置) {
    返回 生成YAML文本(配置, 2)
}

导出 文本:转紧凑(对象:配置) {
    返回 生成YAML文本(配置, 4)
}

// 取值

导出 取(对象:配置, 文本:键) {
    返回 对象取(配置, 键)
}

导出 取段(对象:配置, 文本:键) {
    返回 对象取(配置, 键)
}

导出 数字:取数字(对象:配置, 文本:键, 数字:缺省) {
    返回 INI转数字(对象取(配置, 键), 缺省)
}

导出 真假:取真假(对象:配置, 文本:键) {
    返回 对象取(配置, 键) == 真
}

// 修改

导出 设(对象:配置, 文本:键, 任意:值) {
    返回 对象设(配置, 键, 值)
}

导出 删(对象:配置, 文本:键) {
    返回 对象删(配置, 键)
}

// 判断与枚举

导出 真假:有(对象:配置, 文本:键) {
    返回 对象有(配置, 键)
}

导出 数组:键列表(对象:配置) {
    返回 对象键列表(配置)
}

导出 数字:项数(对象:配置) {
    返回 对象项数(配置)
}
