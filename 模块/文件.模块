// 文件模块
//
// 提供以下导出函数
//
// 读取(路径)：获取文件里的全部文本，文件不存在时为空文本
// 写入(路径, 文本)：把文本写进文件，成功为真
// 追加(路径, 文本)：把文本接到文件末尾，成功为真
// 复制(路径, 目标)：把文件复制到目标位置，成功为真
// 移动(路径, 目标)：把文件移动到目标位置，成功为真
// 删除(路径)：删除文件，成功为真
// 存在(路径)：判断路径是否存在
// 是文件(路径)：判断路径是否为文件
// 是目录(路径)：判断路径是否为目录
// 大小(路径)：获取路径对应文件的大小
// 扩展名(路径)：获取路径的扩展名，没有扩展名时为空文本
// 文件名(路径)：获取路径最后的名字
//
// 以上注释不可修改

// 打开与关闭

导出 对象:打开读取(文本:路径) {
    返回 open(路径, "r", encoding="utf-8")
}

导出 对象:打开写入(文本:路径, 文本:模式) {
    返回 open(路径, 模式, encoding="utf-8")
}

导出 空白:关闭(对象:文件) {
    文件.close()
}

// 读取

导出 文本:读取(文本:路径) {
    路径存在(路径) == 假 && 返回 ""
    变量 对象:文件 = 打开读取(路径)
    变量 文本:内容 = 文件.read()
    关闭(文件)
    返回 内容
}

// 写入

导出 真假:写入(文本:路径, 文本:内容) {
    变量 对象:文件 = 打开写入(路径, "w")
    文件.write(内容)
    关闭(文件)
    返回 真
}

导出 真假:追加(文本:路径, 文本:内容) {
    变量 对象:文件 = 打开写入(路径, "a")
    文件.write(内容)
    关闭(文件)
    返回 真
}

// 复制与移动

导出 真假:复制(文本:路径, 文本:目标) {
    路径存在(路径) == 假 && 返回 假
    写入(目标, 读取(路径))
    返回 真
}

导出 真假:移动(文本:路径, 文本:目标) {
    路径存在(路径) == 假 && 返回 假
    复制(路径, 目标)
    删除(路径)
    返回 真
}

// 删除

导出 真假:删除(文本:路径) {
    路径是文件(路径) == 假 && 返回 假
    删除路径(路径)
    返回 真
}

// 判断

导出 真假:存在(文本:路径) {
    返回 路径存在(路径)
}

导出 真假:是文件(文本:路径) {
    返回 路径是文件(路径)
}

导出 真假:是目录(文本:路径) {
    返回 路径是目录(路径)
}

// 信息

导出 数字:大小(文本:路径) {
    返回 路径大小(路径)
}

导出 文本:扩展名(文本:路径) {
    变量 文本:各段 = 路径.split("/")
    变量 文本:最后 = 各段[len(各段) - 1]
    变量 数字:位置 = 最后.rfind(".")
    位置 <= 0 && 返回 ""
    返回 最后[位置 + 1:]
}

导出 文本:文件名(文本:路径) {
    变量 文本:各段 = 路径.split("/")
    返回 各段[len(各段) - 1]
}
