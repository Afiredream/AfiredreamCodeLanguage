# 语法高亮示例
# 覆盖燃梦中文语言的各类语法元素

# ── 定义语句 ──────────────────────────────────────────────

常量 文本:名称 = "张三"
变量 数字:年龄 = 18
变量 状态:在职 = 真
容量 列表:爱好 = ["读书", "旅行"]
类型 结构:点 = 原点

# ── 函数定义 ──────────────────────────────────────────────

函数 文本:问候(文本:对象) {
    返回 文本拼接("你好，", 对象)
}

导出 数字:求和(数字:首个, 数字:其余...) {
    变量 数字:总数 = 首个
    变量 数字:序号 = 0
    循环(序号 < len(其余)) {
        总数 = 总数 + 其余[序号]
        序号++
    }
    返回 总数
}

# ── 控制语句 ──────────────────────────────────────────────

导出 状态:判断(数字:分数) {
    如果(分数 >= 60) {
        返回 真
    } 或者(分数 >= 50) {
        返回 真
    }
    返回 假
}

# ── 运算符与比较 ──────────────────────────────────────────

变量 数字:合计 = 1 + 2 - 3 * 4 / 5 % 6
变量 状态:较大 = 年龄 > 10
变量 状态:相等 = 年龄 == 18
变量 状态:不等 = 年龄 != 0
变量 状态:包含 = "读书" in 爱好

如果(在职 and 较大) {
    终端输出("在职且年龄大于 10")
}
如果(not 在职) {
    终端输出("不在职")
}

# ── 调用与管道 ────────────────────────────────────────────

终端输出(问候("世界"))
终端输出(文本长度("一串文本"))

导入 模块/文本 选择 分割
变量 数组:片段 = 分割("甲,乙,丙", ",")

# ── 导入与导出 ────────────────────────────────────────────

导入 模块/文本 命名 文本模块
导入 模块/路径 选择 拼接, 目录

导出 求和, 判断

# ── 注释与特殊值 ──────────────────────────────────────────

# 这是行注释
变量 文本:单引号 = '也可以用单引号'
变量 文本:空值 = None
# 说明：小数目前只支持解析，运行期会按整数读取，此处仅演示高亮
变量 数字:整数 = 42
变量 数字:负数 = -5
