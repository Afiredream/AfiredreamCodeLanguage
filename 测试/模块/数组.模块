// 数组模块
//
// 约定：
//   · 每个函数的第一个参数都是要处理的数组
//   · 位置从 1 开始数，找不到时返回 0
//   · 返回真假时给出「真」「假」
//
// 实现思路与文本模块一致：
//   只有 长度 / 索引 / 拼接 三个基础函数直接依赖语言底层，
//   其余函数一律通过它们互相调用实现。

// 基础函数

导出 数字:长度(列表:参数) {
    返回 len(参数)
}

导出 任意:索引(列表:参数, 数字:位置) {
    # 语言里的位置从 1 开始数，自减后正好对上列表下标
    位置--
    返回 参数[位置]
}

导出 列表:拼接(列表:参数...) {
    变量 列表:结果 = []
    变量 数字:序号 = 0
    循环(序号 < len(参数)) {
        结果 = 结果 + 参数[序号]
        序号++
    }
    返回 结果
}

// 取元素与切割

导出 列表:切割(列表:a, 数字:开始, 数字:结束) {
    变量 列表:结果 = []
    变量 数字:序号 = 开始
    循环(序号 <= 结束 and 序号 <= 长度(a)) {
        结果 = 结果 + [索引(a, 序号)]
        序号++
    }
    返回 结果
}

导出 列表:截断(列表:a, 数字:限定长度) {
    返回 切割(a, 1, 限定长度)
}

// 查找

导出 数字:查找(列表:a, 任意:目标) {
    // 逐位置比对，返回第一次出现的位置，找不到返回 0
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        如果(索引(a, 序号) == 目标) {
            返回 序号
        }
        序号++
    }
    返回 0
}

导出 状态:包含(列表:a, 任意:目标) {
    如果(查找(a, 目标) > 0) {
        返回 真
    }
    返回 假
}

导出 状态:开头(列表:a, 任意:目标) {
    如果(长度(a) == 0) {
        返回 假
    }
    如果(索引(a, 1) == 目标) {
        返回 真
    }
    返回 假
}

导出 状态:结尾(列表:a, 任意:目标) {
    如果(长度(a) == 0) {
        返回 假
    }
    如果(索引(a, 长度(a)) == 目标) {
        返回 真
    }
    返回 假
}

// 增删

导出 列表:追加(列表:a, 任意:项) {
    返回 a + [项]
}

导出 列表:删除(列表:a, 数字:位置) {
    变量 列表:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        如果(序号 != 位置) {
            结果 = 结果 + [索引(a, 序号)]
        }
        序号++
    }
    返回 结果
}

导出 列表:插入(列表:a, 数字:位置, 任意:项) {
    变量 列表:结果 = []
    变量 数字:序号 = 1
    如果(位置 <= 1) {
        结果 = 结果 + [项]
    }
    循环(序号 <= 长度(a)) {
        结果 = 结果 + [索引(a, 序号)]
        如果(序号 == 位置 - 1) {
            结果 = 结果 + [项]
        }
        序号++
    }
    返回 结果
}

导出 列表:修改(列表:a, 数字:位置, 任意:项) {
    变量 列表:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        如果(序号 == 位置) {
            结果 = 结果 + [项]
        } 或者(真) {
            结果 = 结果 + [索引(a, 序号)]
        }
        序号++
    }
    返回 结果
}

// 变换

导出 列表:反转(列表:a) {
    变量 列表:结果 = []
    变量 数字:序号 = 长度(a)
    循环(序号 >= 1) {
        结果 = 结果 + [索引(a, 序号)]
        序号--
    }
    返回 结果
}

导出 列表:去重(列表:a) {
    变量 列表:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        变量 任意:项 = 索引(a, 序号)
        如果(查找(结果, 项) == 0) {
            结果 = 结果 + [项]
        }
        序号++
    }
    返回 结果
}

导出 列表:排序(列表:a) {
    // 冒泡排序：逐轮把较大的元素往后推
    变量 列表:结果 = a
    变量 数字:总数 = 长度(结果)
    变量 数字:轮次 = 0
    循环(轮次 < 总数) {
        变量 数字:序号 = 1
        循环(序号 < 总数 - 轮次) {
            变量 任意:左 = 结果[序号 - 1]
            变量 任意:右 = 结果[序号]
            如果(左 > 右) {
                结果[序号 - 1] = 右
                结果[序号] = 左
            }
            序号++
        }
        轮次++
    }
    返回 结果
}

// 取值

// 说明：求最大值、最小值、求和属于数学运算，放在数学模块里，
// 这里只负责数组本身的结构操作（取首项、末项等）。

导出 任意:首项(列表:a) {
    返回 索引(a, 1)
}

导出 任意:末项(列表:a) {
    返回 索引(a, 长度(a))
}

// 遍历

导出 空白:遍历(列表:a, f) {
    // 对每个元素调用一次 f，不收集返回值
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        f(索引(a, 序号), 序号)
        序号++
    }
}

导出 列表:映射(列表:a, f) {
    // 对每个元素调用 f，把结果收集成新数组
    变量 列表:结果 = []
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        结果 = 结果 + [f(索引(a, 序号), 序号)]
        序号++
    }
    返回 结果
}

导出 列表:筛选(列表:a, f) {
    // 保留 f 返回真值的元素
    变量 列表:结果 = []
    变量 数字:序号 = 1
    变量 状态:保留 = 假
    循环(序号 <= 长度(a)) {
        变量 任意:项 = 索引(a, 序号)
        保留 = f(项, 序号)
        如果(保留) {
            结果 = 结果 + [项]
        }
        序号++
    }
    返回 结果
}

导出 任意:归并(列表:a, f, 任意:初始) {
    // 从左到右累积：第一次传 初始 与首项，之后传上次结果与下一项
    变量 任意:结果 = 初始
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        结果 = f(结果, 索引(a, 序号))
        序号++
    }
    返回 结果
}

// 判断

导出 真假:空白(数组:参数) {
    长度(参数) == 0 && 返回 真 
    返回 假
}