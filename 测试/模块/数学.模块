// 数列

导出 数字:阶乘(数字:n) {
    如果(n < 0) {
        终端输出("阶乘不能作用于负数")
        返回 1
    }
    变量 数字:结果 = 1
    变量 数字:序号 = 2
    循环(序号 <= n) {
        结果 = 结果 * 序号
        序号++
    }
    返回 结果
}

导出 数字:求和区间(数字:开始, 数字:结束) {
    变量 数字:结果 = 0
    变量 数字:序号 = 开始
    循环(序号 <= 结束) {
        结果 = 结果 + 序号
        序号++
    }
    返回 结果
}

// 进制转换

导出 文本:转进制(数字:a, 数字:进制) {
    如果(进制 < 2 or 进制 > 36) {
        终端输出("进制必须在 2 到 36 之间")
        返回 ""
    }
    如果(a == 0) {
        返回 "0"
    }
    变量 文本:数字集 = "0123456789abcdefghijklmnopqrstuvwxyz"
    变量 文本:结果 = ""
    变量 数字:当前 = 绝对值(a)
    循环(当前 > 0) {
        变量 数字:余数 = 取整数余(当前, 进制)
        结果 = 文本.索引(数字集, 余数 + 1) + 结果
        变量 数字:剩余 = 当前 - 余数
        当前 = 取零整(剩余 / 进制)
    }
    如果(a < 0) {
        返回 "-" + 结果
    }
    返回 结果
}

导出 文本:转二进制(数字:a) {
    返回 转进制(a, 2)
}

导出 文本:转八进制(数字:a) {
    返回 转进制(a, 8)
}

导出 文本:转十六进制(数字:a) {
    返回 转进制(a, 16)
}
