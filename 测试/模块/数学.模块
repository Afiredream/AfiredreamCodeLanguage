// 基础运算

导出 数字:绝对值(数字:a) {
    如果(a < 0) {
        返回 0 - a
    }
    返回 a
}

导出 数字:取零整(数字:a) {
    // 去掉小数部分，向零靠拢：3.7 → 3，-2.7 → -2
    如果(a >= 0) {
        返回 a - a % 1
    }
    变量 数字:正数 = 0 - a
    返回 a + 正数 % 1
}

导出 数字:向下取整(数字:a) {
    // 向负无穷靠拢：3.7 → 3，-2.7 → -3
    返回 a - a % 1
}

导出 数字:向上取整(数字:a) {
    // 向正无穷靠拢：3.2 → 4，-2.7 → -2
    变量 数字:向下 = a - a % 1
    如果(向下 == a) {
        返回 向下
    }
    返回 向下 + 1
}

导出 数字:四舍五入(数字:a) {
    // 看小数部分是否达到 0.5
    变量 数字:向下 = a - a % 1
    变量 数字:小数部分 = a - 向下
    如果(小数部分 >= 0.5) {
        返回 向下 + 1
    }
    返回 向下
}

导出 数字:取余(数字:被除数, 数字:除数) {
    如果(除数 == 0) {
        终端输出("除数不能为零")
        返回 0
    }
    返回 被除数 % 除数
}

导出 数字:取整数余(数字:被除数, 数字:除数) {
    // 返回整数余数，供进制转换这类需要整数下标的场合使用
    返回 取零整(被除数 - 取零整(被除数 / 除数) * 除数)
}

导出 数字:整除(数字:被除数, 数字:除数) {
    如果(除数 == 0) {
        终端输出("除数不能为零")
        返回 0
    }
    返回 取零整(被除数 / 除数)
}

导出 数字:除法(数字:被除数, 数字:除数) {
    如果(除数 == 0) {
        终端输出("除数不能为零")
        返回 0
    }
    返回 被除数 / 除数
}

// 幂与根

导出 数字:幂(数字:底, 数字:指数) {
    如果(指数 == 0) {
        返回 1
    }
    变量 数字:结果 = 1
    变量 数字:次数 = 绝对值(指数)
    变量 数字:序号 = 1
    循环(序号 <= 次数) {
        结果 = 结果 * 底
        序号++
    }
    如果(指数 < 0) {
        返回 1 / 结果
    }
    返回 结果
}

导出 数字:平方(数字:a) {
    返回 a * a
}

导出 数字:立方(数字:a) {
    返回 a * a * a
}

导出 数字:平方根(数字:a) {
    如果(a < 0) {
        终端输出("平方根不能作用于负数")
        返回 0
    }
    如果(a == 0) {
        返回 0
    }
    // 牛顿迭代法：从 a 开始逐步逼近
    变量 数字:猜测 = a
    变量 数字:序号 = 0
    循环(序号 < 30) {
        变量 数字:和 = 猜测 + a / 猜测
        猜测 = 和 / 2
        序号++
    }
    返回 猜测
}

// 冻结
导出 数字:取最小值(数字:参数...) {
    数组.空白(参数) && 返回 正无穷大
    变量 数字:数值
    变量 数字:索引 = 0
    变量 数字:结果 = 正无穷大
    常量 数字:长度 = 数组.长度(参数)
    循环(索引 < 长度) {
        索引++
        数值 = 参数[索引]
        结果 > 数值 && 结果 = 数值
    }
    返回 结果
}

// 冻结
导出 数字:取最大值(数字:参数...) {
    数组.空白(参数) && 返回 负无穷大
    变量 数字:数值
    变量 数字:索引 = 0
    变量 数字:结果 = 负无穷大
    常量 数字:长度 = 数组.长度(参数)
    循环(索引 < 长度) {
        索引++
        数值 = 参数[索引]
        结果 < 数值 && 结果 = 数值
    }
    返回 结果
}

导出 数字:总和(数字:参数...) {
    变量 数字:结果 = 0
    变量 数字:序号 = 0
    循环(序号 < len(参数)) {
        结果 = 结果 + 参数[序号]
        序号++
    }
    返回 结果
}

导出 数字:平均值(数字:参数...) {
    如果(len(参数) == 0) {
        返回 0
    }
    // 这里直接累加，避免把整个列表当成一个参数再传给 总和
    变量 数字:合计 = 0
    变量 数字:序号 = 0
    循环(序号 < len(参数)) {
        合计 = 合计 + 参数[序号]
        序号++
    }
    返回 合计 / len(参数)
}

