
# 文本模块
#
# 约定：
#   · 每个函数的第一个参数都是要处理的文本
#   · 位置从 1 开始数，找不到时返回 0
#   · 返回真假时给出「真」「假」
#
# 实现方式：直接使用 Python 自带的字符串方法与内置函数，不额外新增底层函数。

# ── 基本度量 ──────────────────────────────────────────────

导出 大小(文本:a) {
    返回 len(a.encode("utf-8"))
}

导出 长度(文本:a) {
    返回 len(a)
}

# ── 拼接 ──────────────────────────────────────────────────

导出 拼接(文本:a, 文本:b, 文本:c, 文本:d, 文本:e, 文本:f, 文本:g, 文本:h) {
    返回 a + b + c + d + e + f + g + h
}

# ── 取字符与切割 ──────────────────────────────────────────

导出 索引(文本:a, 数字:位置) {
    返回 a[位置 - 1]
}

导出 切割(文本:a, 数字:开始, 数字:结束) {
    返回 a[开始 - 1:结束]
}

导出 截断(文本:a, 数字:限定长度) {
    返回 a[:限定长度]
}

# ── 查找 ──────────────────────────────────────────────────

导出 查找(文本:a, 文本:子文本) {
    返回 a.find(子文本) + 1
}

导出 包含(文本:a, 文本:子文本) {
    如果(子文本 in a) {
        返回 "真"
    }
    返回 "假"
}

导出 开头(文本:a, 文本:前缀) {
    如果(a.startswith(前缀)) {
        返回 "真"
    }
    返回 "假"
}

导出 结尾(文本:a, 文本:后缀) {
    如果(a.endswith(后缀)) {
        返回 "真"
    }
    返回 "假"
}

# ── 分割与连接 ────────────────────────────────────────────

导出 分割(文本:a, 文本:分隔符) {
    返回 a.split(分隔符)
}

导出 连接(列表:a, 文本:分隔符) {
    返回 分隔符.join(a)
}

# ── 大小写 ────────────────────────────────────────────────

导出 字母大写(文本:a) {
    返回 a.upper()
}

导出 字母小写(文本:a) {
    返回 a.lower()
}

导出 驼峰命名(文本:a) {
    返回 a.capitalize()
}

# ── 清理与替换 ────────────────────────────────────────────

导出 去除两端空白(文本:a) {
    返回 a.strip()
}

导出 替换(文本:a, 文本:旧文本, 文本:新文本) {
    返回 a.replace(旧文本, 新文本)
}

# ── 规范与匹配 ────────────────────────────────────────────

导出 规范(文本:a) {
    # 把连续空白（含换行）压成一个空格，并去掉两端空白
    返回 " ".join(a.split())
}

导出 匹配(文本:a, 文本:格式) {
    返回 正则查找(a, 格式)
}
