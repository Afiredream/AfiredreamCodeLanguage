# 文本模块
#
# 约定：
#   · 每个函数的第一个参数都是要处理的文本
#   · 位置从 1 开始数，找不到时返回 0
#   · 返回真假时给出「真」「假」
#
# 实现思路：
#   只有 长度 / 索引 / 拼接 三个基础函数直接依赖语言底层，
#   其余函数一律通过它们互相调用实现。

// 基础函数

导出 数字:长度(文本:参数) {
    返回 len(参数)
}

导出 数字:大小(文本:参数) {
    返回 len(参数.encode("utf-8"))
}
 
导出 文本:索引(文本:参数, 数字:位置) {
    // 位置从 1 开始数；转成整数后自减，得到从 0 开始的下标
    变量 数字:下标 = int(位置)
    下标--
    返回 参数[下标]
}

导出 文本:拼接(文本:参数...) {
    返回 "".join(参数)
}

// 模块函数

导出 文本:切割(文本:a, 数字:开始, 数字:结束) {
    变量 文本:结果 = ""
    变量 数字:当前位置 = 开始
    循环(当前位置 <= 结束 and 当前位置 <= 长度(a)) {
        结果 = 拼接(结果, 索引(a, 当前位置))
        当前位置++
    }
    返回 结果
}

导出 文本:截断(文本:a, 数字:限定长度) {
    返回 切割(a, 1, 限定长度)
}

# ══ 查找 ══════════════════════════════════════════════════

导出 数字:查找(文本:a, 文本:子文本) {
    # 逐位置比对，返回第一次出现的位置，找不到返回 0
    变量 数字:总长 = 长度(a)
    变量 数字:子长 = 长度(子文本)
    如果(子长 == 0) {
        返回 0
    }
    变量 数字:起点 = 1
    循环(起点 + 子长 - 1 <= 总长) {
        如果(切割(a, 起点, 起点 + 子长 - 1) == 子文本) {
            返回 起点
        }
        起点++
    }
    返回 0
}

导出 状态:包含(文本:a, 文本:子文本) {
    如果(查找(a, 子文本) > 0) {
        返回 真
    }
    返回 假
}

导出 状态:开头(文本:a, 文本:前缀) {
    变量 数字:总长 = 长度(a)
    变量 数字:前长 = 长度(前缀)
    如果(前长 > 总长) {
        返回 假
    }
    如果(切割(a, 1, 前长) == 前缀) {
        返回 真
    }
    返回 假
}

导出 状态:结尾(文本:a, 文本:后缀) {
    变量 数字:总长 = 长度(a)
    变量 数字:后长 = 长度(后缀)
    如果(后长 > 总长) {
        返回 假
    }
    如果(切割(a, 总长 - 后长 + 1, 总长) == 后缀) {
        返回 真
    }
    返回 假
}

# ══ 分割与连接 ════════════════════════════════════════════

导出 列表:分割(文本:a, 文本:分隔符) {
    变量 数组:结果 = []
    变量 数字:分隔长 = 长度(分隔符)
    变量 数字:总长 = 长度(a)
    变量 数字:开始 = 1
    变量 数字:当前位置 = 1
    循环(当前位置 + 分隔长 - 1 <= 总长) {
        如果(切割(a, 当前位置, 当前位置 + 分隔长 - 1) == 分隔符) {
            结果 = 结果 + [切割(a, 开始, 当前位置 - 1)]
            当前位置 = 当前位置 + 分隔长
            开始 = 当前位置
        } 或者(真) {
            当前位置++
        }
    }
    结果 = 结果 + [切割(a, 开始, 总长)]
    返回 结果
}

导出 文本:连接(列表:a, 文本:分隔符) {
    如果(len(a) == 0) {
        返回 ""
    }
    变量 文本:结果 = str(a[0])
    变量 数字:序号 = 1
    循环(序号 < len(a)) {
        结果 = 拼接(结果, 分隔符, a[序号])
        序号++
    }
    返回 结果
}

# ══ 大小写 ════════════════════════════════════════════════

导出 文本:字母大写(文本:a) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 97 and 码 <= 122) {
            结果 = 拼接(结果, chr(码 - 32))
        } 或者(真) {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:字母小写(文本:a) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 65 and 码 <= 90) {
            结果 = 拼接(结果, chr(码 + 32))
        } 或者(真) {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:驼峰命名(文本:a) {
    如果(长度(a) == 0) {
        返回 ""
    }
    返回 拼接(字母大写(索引(a, 1)), 切割(a, 2, 长度(a)))
}

# ══ 清理与替换 ════════════════════════════════════════════

导出 文本:去除两端空白(文本:a) {
    变量 数字:左 = 1
    变量 数字:右 = 长度(a)
    循环(左 <= 右 and 索引(a, 左) == " ") {
        左++
    }
    循环(右 >= 左 and 索引(a, 右) == " ") {
        右--
    }
    如果(左 > 右) {
        返回 ""
    }
    返回 切割(a, 左, 右)
}

导出 文本:替换(文本:a, 文本:旧文本, 文本:新文本) {
    变量 文本:结果 = ""
    变量 数字:旧长 = 长度(旧文本)
    变量 数字:总长 = 长度(a)
    变量 数字:当前位置 = 1
    循环(当前位置 <= 总长) {
        如果(当前位置 + 旧长 - 1 <= 总长 and
             切割(a, 当前位置, 当前位置 + 旧长 - 1) == 旧文本) {
            结果 = 拼接(结果, 新文本)
            当前位置 = 当前位置 + 旧长
        } 或者(真) {
            结果 = 拼接(结果, 索引(a, 当前位置))
            当前位置++
        }
    }
    返回 结果
}

# ══ 规范 ══════════════════════════════════════════════════

导出 文本:规范(文本:a) {
    # 把连续空白压成一个空格，并去掉两端空白
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    变量 数字:上次是空白 = 0
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        如果(字 == " " or 字 == "　") {
            如果(上次是空白 == 0 and 长度(结果) > 0) {
                结果 = 拼接(结果, " ")
            }
            上次是空白 = 1
        } 或者(真) {
            结果 = 拼接(结果, 字)
            上次是空白 = 0
        }
        序号++
    }
    返回 去除两端空白(结果)
}

# ══ 匹配 ══════════════════════════════════════════════════

导出 列表:匹配(文本:a, 文本:格式) {
    返回 正则查找(a, 格式)
}
