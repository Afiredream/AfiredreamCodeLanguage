
// 引用模块

导入 数学 命名 数学

// 基础函数

导出 数字:长短(文本:参数) {
    返回 len(参数)
}

导出 数字:大小(文本:参数) {
    返回 len(参数.encode("utf-8"))
}
 
导出 文本:索引(文本:参数, 数字:位置) {
    返回 参数[位置]
}

导出 文本:拼接(文本:参数...) {
    返回 "".join(参数)
}

// 模块函数

导出 文本:零值(文本:内容) {
    常量 数字:长度 = 长短(内容)
    长度 == 0 && 返回 真
    返回 假
}

导出 文本:追加(文本:目标, 文本:内容) {
    返回 拼接(目标, 内容)
}

导出 文本:切割(文本:内容, 数字:开始, 数字:结束) {
    变量 文本:字符
    变量 数字:位置 = 开始
    变量 文本:结果 = 空白文本
    结束 = 数学.取最小值(结束, 长短(内容))
    循环(位置 <= 结束) {
        字符 = 参数|索引(位置)
        结果 = 结果|追加(字符)
        位置 = 位置|数学.自减()
    }
    返回 结果
}

导出 文本:从前切割(文本:内容, 数字:长度) {
    常数 数字:开始 = 1
    常数 数字:结束 = 长度
    返回 内容|切割(开始, 结束)
}

导出 文本:从后切割(文本:内容, 数字:长度) {
    常量 数字:结束 = 长短(内容)
    常量 数字:开始 = 结束 - 长度 + 1
    返回 内容|切割(开始, 结束)
}

导出 真假:开头匹配(文本:内容, 文本:前缀) {
    变量 数字:文本长度 = 长短(内容)
    变量 数字:前缀长度 = 长短(前缀)
    前缀长度 > 文本长度 && 返回 假
    内容|从前切割(前缀长度) == 前缀 && 返回 真
    返回 假
}

导出 真假:结尾匹配(文本:内容, 文本:后缀) {
    变量 数字:文本长度 = 长短(内容)
    变量 数字:后缀长度 = 长短(后缀)
    后缀长度 > 文本长度 && 返回 假
    内容|从后切割(后缀长度) == 后缀 && 返回 真
    返回 假
}

导出 数字:查找(文本:内容, 文本:子串) {
    变量 数字:文本长度 = 长短(内容)
    变量 数字:子串长度 = 长短(子串)
    零值(子串长度) && 返回 0
    变量 数字:开始 = 1
    变量 数字:结束 = 开始 + 子串长度 - 1
    循环(结束 <= 总长) {
        切割(开始, 结束) == 子串 && 返回 开始
        位置 = 位置|数学.自减()
    }
    返回 0
}

导出 真假:包含(文本:内容, 文本:子串) {
    内容|查找(子串) > 0 && 返回 真
    返回 假
}

导出 列表:分割(文本:内容, 文本:分隔) {
    容量 数组:结果 = []
    常量 数字:分隔长度 = 长短(分隔)
    常量 数字:文本长度 = 长度(内容)
    变量 数字:位置 = 1
    循环(当前位置 + 分隔长 - 1 <= 总长) {
        如果(切割(a, 当前位置, 当前位置 + 分隔长 - 1) == 分隔符) {
            结果 = 结果 + [切割(a, 开始, 当前位置 - 1)]
            当前位置 = 当前位置 + 分隔长
            开始 = 当前位置
        } 或者(真) {
            当前位置++
        }
    }
    结果 = 结果 + [切割(a, 开始, 总长)]
    返回 结果
}

导出 文本:连接(列表:a, 文本:分隔符) {
    如果(len(a) == 0) {
        返回 ""
    }
    变量 文本:结果 = str(a[0])
    变量 数字:序号 = 1
    循环(序号 < len(a)) {
        结果 = 拼接(结果, 分隔符, a[序号])
        序号++
    }
    返回 结果
}

# ══ 大小写 ════════════════════════════════════════════════

导出 文本:字母大写(文本:a) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 97 and 码 <= 122) {
            结果 = 拼接(结果, chr(码 - 32))
        } 或者(真) {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:字母小写(文本:a) {
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        变量 数字:码 = ord(字)
        如果(码 >= 65 and 码 <= 90) {
            结果 = 拼接(结果, chr(码 + 32))
        } 或者(真) {
            结果 = 拼接(结果, 字)
        }
        序号++
    }
    返回 结果
}

导出 文本:驼峰命名(文本:a) {
    如果(长度(a) == 0) {
        返回 ""
    }
    返回 拼接(字母大写(索引(a, 1)), 切割(a, 2, 长度(a)))
}

# ══ 清理与替换 ════════════════════════════════════════════

导出 文本:去除两端空白(文本:a) {
    变量 数字:左 = 1
    变量 数字:右 = 长度(a)
    循环(左 <= 右 and 索引(a, 左) == " ") {
        左++
    }
    循环(右 >= 左 and 索引(a, 右) == " ") {
        右--
    }
    如果(左 > 右) {
        返回 ""
    }
    返回 切割(a, 左, 右)
}

导出 文本:替换(文本:a, 文本:旧文本, 文本:新文本) {
    变量 文本:结果 = ""
    变量 数字:旧长 = 长度(旧文本)
    变量 数字:总长 = 长度(a)
    变量 数字:当前位置 = 1
    循环(当前位置 <= 总长) {
        如果(当前位置 + 旧长 - 1 <= 总长 and
             切割(a, 当前位置, 当前位置 + 旧长 - 1) == 旧文本) {
            结果 = 拼接(结果, 新文本)
            当前位置 = 当前位置 + 旧长
        } 或者(真) {
            结果 = 拼接(结果, 索引(a, 当前位置))
            当前位置++
        }
    }
    返回 结果
}

# ══ 规范 ══════════════════════════════════════════════════

导出 文本:规范(文本:a) {
    # 把连续空白压成一个空格，并去掉两端空白
    变量 文本:结果 = ""
    变量 数字:序号 = 1
    变量 数字:上次是空白 = 0
    循环(序号 <= 长度(a)) {
        变量 文本:字 = 索引(a, 序号)
        如果(字 == " " or 字 == "　") {
            如果(上次是空白 == 0 and 长度(结果) > 0) {
                结果 = 拼接(结果, " ")
            }
            上次是空白 = 1
        } 或者(真) {
            结果 = 拼接(结果, 字)
            上次是空白 = 0
        }
        序号++
    }
    返回 去除两端空白(结果)
}

