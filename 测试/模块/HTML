
# HTML 模块
#
# 约定：
#   · 基于 Python 标准库解析，不依赖第三方库
#   · 元素以对象形式给出：标签、属性、文本、全部文本、父元素
#   · 找不到的内容返回空文本
#
# 注意：导出名不要和调用的底层函数重名，否则会自我递归。

# ── 解析 ──────────────────────────────────────────────────

导出 解析(文本:a) {
    返回 解析HTML文本(a)
}

导出 文本(文本:a) {
    返回 提取HTML文本(a)
}

# ── 按标签查找 ────────────────────────────────────────────

导出 查找(文本:a, 文本:标签) {
    返回 查找HTML元素(a, 标签)
}

导出 标签文本(文本:a, 文本:标签) {
    返回 提取HTML标签文本(a, 标签)
}

导出 属性(文本:a, 文本:标签, 文本:属性名) {
    返回 提取HTML属性(a, 标签, 属性名)
}

# ── 转义 ──────────────────────────────────────────────────

导出 转义(文本:a) {
    返回 转义HTML文本(a)
}

导出 反转义(文本:a) {
    返回 反转义HTML文本(a)
}

# ── 从元素对象里取值 ──────────────────────────────────────

导出 取标签(对象:a) {
    返回 对象取(a, "标签")
}

导出 取文本(对象:a) {
    返回 对象取(a, "全部文本")
}

导出 取属性表(对象:a) {
    返回 对象取(a, "属性")
}

导出 取属性值(对象:a, 文本:属性名) {
    返回 对象取(对象取(a, "属性"), 属性名)
}
