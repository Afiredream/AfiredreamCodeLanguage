
# YAML 模块
#
# 约定：
#   · 配置就是 {节: 值} 结构的对象
#   · 自带解析器，不依赖第三方库
#   · 支持：映射、列表、缩进嵌套、引号文本、# 注释、
#           | 与 > 多行文本、真假、数字、null
#
# 注意：导出名不要和调用的底层函数重名，否则会自我递归。

# ── 解析与生成 ────────────────────────────────────────────

导出 解析(文本:a) {
    返回 解析YAML文本(a)
}

导出 转文本(对象:a) {
    返回 生成YAML文本(a, 2)
}

导出 转紧凑(对象:a) {
    返回 生成YAML文本(a, 4)
}

# ── 取值 ──────────────────────────────────────────────────

导出 取(对象:a, 文本:键) {
    返回 对象取(a, 键)
}

导出 取段(对象:a, 文本:键) {
    返回 对象取(a, 键)
}

导出 取数字(对象:a, 文本:键, 数字:缺省) {
    返回 INI转数字(对象取(a, 键), 缺省)
}

导出 取真假(对象:a, 文本:键) {
    如果(对象取(a, 键) == 真) {
        返回 "真"
    }
    返回 "假"
}

# ── 修改 ──────────────────────────────────────────────────

导出 设(对象:a, 文本:键, x) {
    返回 对象设(a, 键, x)
}

导出 删(对象:a, 文本:键) {
    返回 对象删(a, 键)
}

# ── 判断与枚举 ────────────────────────────────────────────

导出 有(对象:a, 文本:键) {
    如果(对象有(a, 键)) {
        返回 "真"
    }
    返回 "假"
}

导出 键列表(对象:a) {
    返回 对象键列表(a)
}

导出 项数(对象:a) {
    返回 对象项数(a)
}
