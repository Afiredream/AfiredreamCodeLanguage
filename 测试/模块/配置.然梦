
# 配置模块（INI）
#
# 约定：
#   · 配置以 {节: {键: 值}} 的对象形式给出
#   · 兼容常见 INI 写法：= 与 : 分隔、# 与 ; 注释、
#     重复键（以后者为准）、% 原样保留、多行值、空值
#   · 值一律按文本读入，需要数字或真假时用 取数字 / 取真假
#
# 实现方式：直接使用 Python 的 configparser 标准库，不额外新增底层函数。

# ── 读取与写入 ────────────────────────────────────────────

导出 读取(文本:a) {
    如果(not 路径是文件(a)) {
        终端输出("读取配置文件失败：文件不存在 -> " + a)
        返回 {}
    }
    变量 文本:原文 = 读取文本(a)
    返回 解析(原文)
}

导出 写入(文本:a, 对象:b) {
    返回 写入文本(a, 转文本(b))
}

# ── 与文本互转 ────────────────────────────────────────────

导出 解析(文本:a) {
    变量 对象:解析器 = 新建解析器()
    变量 文本:原文 = a
    如果(原文.startswith("﻿")) {
        原文 = 原文[1:]
    }
    解析器.read_string(原文)
    变量 对象:结果 = {}
    变量 数字:序号 = 0
    变量 数组:节名 = 解析器.sections()
    循环(序号 < len(节名)) {
        变量 文本:节 = 节名[序号]
        结果[节] = 段内容(解析器, 节)
        序号++
    }
    返回 结果
}

导出 转文本(对象:a) {
    变量 数组:行 = []
    变量 数组:节名 = list(a.keys())
    变量 数字:序号 = 0
    循环(序号 < len(节名)) {
        变量 文本:节 = 节名[序号]
        行 = 行 + ["[" + 节 + "]"]
        变量 数组:键名 = list(a[节].keys())
        变量 数字:键序 = 0
        循环(键序 < len(键名)) {
            行 = 行 + [键名[键序] + " = " + str(a[节][键名[键序]])]
            键序++
        }
        行 = 行 + [""]
        序号++
    }
    返回 chr(10).join(行)
}

# ── 取值 ──────────────────────────────────────────────────

导出 取段(对象:a, 文本:节) {
    返回 a.get(节, {})
}

导出 取(对象:a, 文本:节, 文本:键, 文本:缺省) {
    如果(not a.get(节, None)) {
        返回 缺省
    }
    返回 a[节].get(键, 缺省)
}

导出 取数字(对象:a, 文本:节, 文本:键, 数字:缺省) {
    变量 文本:值 = 取(a, 节, 键, "")
    如果(值 == "") {
        返回 缺省
    }
    返回 int(值)
}

导出 取真假(对象:a, 文本:节, 文本:键) {
    变量 文本:值 = 取(a, 节, 键, "假").strip().lower()
    如果(值 in ["真", "是", "1", "true", "yes", "on"]) {
        返回 "真"
    }
    返回 "假"
}

# ── 修改 ──────────────────────────────────────────────────

导出 设(对象:a, 文本:节, 文本:键, 文本:值) {
    变量 对象:结果 = 复制对象(a)
    如果(not 结果.get(节, None)) {
        结果[节] = {}
    }
    结果[节][键] = 值
    返回 结果
}

导出 删键(对象:a, 文本:节, 文本:键) {
    变量 对象:结果 = 复制对象(a)
    如果(结果.get(节, None)) {
        结果[节].pop(键, None)
    }
    返回 结果
}

导出 删段(对象:a, 文本:节) {
    变量 对象:结果 = 复制对象(a)
    结果.pop(节, None)
    返回 结果
}

# ── 判断与枚举 ────────────────────────────────────────────

导出 有段(对象:a, 文本:节) {
    如果(a.get(节, None)) {
        返回 "真"
    }
    返回 "假"
}

导出 有键(对象:a, 文本:节, 文本:键) {
    如果(a.get(节, None) and a[节].get(键, None)) {
        返回 "真"
    }
    返回 "假"
}

导出 段列表(对象:a) {
    返回 list(a.keys())
}

导出 键列表(对象:a, 文本:节) {
    返回 list(a.get(节, {}).keys())
}

# ── 内部辅助 ──────────────────────────────────────────────

导出 新建解析器() {
    变量 对象:解析器 = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        allow_no_value=True,
        comment_prefixes=["#", ";"],
        inline_comment_prefixes=None,
        empty_lines_in_values=False
    )
    解析器.optionxform = str
    返回 解析器
}

导出 段内容(对象:解析器, 文本:节) {
    变量 对象:内容 = {}
    变量 数组:键名 = 解析器.options(节)
    变量 数字:序号 = 0
    循环(序号 < len(键名)) {
        变量 文本:键 = 键名[序号]
        如果(键 != "DEFAULT") {
            变量 文本:值 = 解析器.get(节, 键)
            如果(值 == None) {
                值 = ""
            }
            内容[键] = 值
        }
        序号++
    }
    返回 内容
}

导出 复制对象(对象:a) {
    变量 对象:结果 = {}
    变量 数组:节名 = list(a.keys())
    变量 数字:序号 = 0
    循环(序号 < len(节名)) {
        结果[节名[序号]] = dict(a[节名[序号]])
        序号++
    }
    返回 结果
}

导出 读取文本(文本:a) {
    变量 文件:f = open(a, "r", encoding="utf-8")
    变量 文本:内容 = f.read()
    f.close()
    返回 内容
}

导出 写入文本(文本:a, 文本:b) {
    变量 文件:f = open(a, "w", encoding="utf-8")
    f.write(b)
    f.close()
    返回 "真"
}
