
# 文件模块
#
# 约定：
#   · 每个函数的第一个参数都是要处理的文件路径
#   · 返回真假时给出「真」「假」
#   · 出错时给出中文提示，不中断程序
#
# 实现方式：直接使用 Python 的 open 与文件方法，不额外新增底层函数。

# ── 读取 ──────────────────────────────────────────────────

导出 读取(文本:a) {
    如果(not 路径存在(a)) {
        终端输出("读取文件失败：文件不存在 -> " + a)
        返回 ""
    }
    变量 文件:f = open(a, "r", encoding="utf-8")
    变量 文本:内容 = f.read()
    f.close()
    返回 内容
}

# ── 写入 ──────────────────────────────────────────────────

导出 写入(文本:a, 文本:b) {
    变量 文件:f = open(a, "w", encoding="utf-8")
    f.write(b)
    f.close()
    返回 "真"
}

导出 追加(文本:a, 文本:b) {
    变量 文件:f = open(a, "a", encoding="utf-8")
    f.write(b)
    f.close()
    返回 "真"
}

# ── 复制与移动 ────────────────────────────────────────────

导出 复制(文本:a, 文本:b) {
    如果(not 路径存在(a)) {
        终端输出("复制文件失败：源文件不存在 -> " + a)
        返回 "假"
    }
    写入(b, 读取(a))
    返回 "真"
}

导出 移动(文本:a, 文本:b) {
    如果(not 路径存在(a)) {
        终端输出("移动文件失败：源文件不存在 -> " + a)
        返回 "假"
    }
    复制(a, b)
    变量 文本:删除结果 = 删除(a)
    返回 "真"
}

# ── 删除 ──────────────────────────────────────────────────

导出 删除(文本:a) {
    如果(not 路径是文件(a)) {
        终端输出("删除文件失败：不是文件 -> " + a)
        返回 "假"
    }
    删除路径(a)
    返回 "真"
}

# ── 判断 ──────────────────────────────────────────────────

导出 存在(文本:a) {
    如果(路径存在(a)) {
        返回 "真"
    }
    返回 "假"
}

导出 是文件(文本:a) {
    如果(路径是文件(a)) {
        返回 "真"
    }
    返回 "假"
}

导出 是目录(文本:a) {
    如果(路径是目录(a)) {
        返回 "真"
    }
    返回 "假"
}

# ── 信息 ──────────────────────────────────────────────────

导出 大小(文本:a) {
    返回 路径大小(a)
}

导出 扩展名(文本:a) {
    变量 文本:最后 = a.split("/")[len(a.split("/")) - 1]
    变量 数字:位置 = 最后.rfind(".")
    如果(位置 <= 0) {
        返回 ""
    }
    返回 最后[位置 + 1:]
}

导出 文件名(文本:a) {
    变量 数组:片段 = a.split("/")
    返回 片段[len(片段) - 1]
}
