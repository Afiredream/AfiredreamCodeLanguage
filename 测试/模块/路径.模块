
# 路径模块
#
# 约定：
#   · 每个函数的第一个参数都是要处理的路径
#   · 路径一律用正斜杠 / 表示
#   · 返回真假时给出「真」「假」
#
# 实现方式：直接使用 Python 自带的字符串方法与内置函数，不额外新增底层函数。

# ── 拼接 ──────────────────────────────────────────────────

导出 拼接(文本:a, 文本:b) {
    如果(b == "") {
        返回 a
    }
    如果(a == "") {
        返回 b
    }
    如果(a.endswith("/")) {
        返回 a + b
    }
    返回 a + "/" + b
}

# ── 目录 ──────────────────────────────────────────────────

导出 目录(文本:a) {
    变量 数组:片段 = a.strip("/").split("/")
    如果(len(片段) <= 1) {
        返回 ""
    }
    变量 数组:前面 = 片段[:len(片段) - 1]
    返回 "/".join(前面)
}

导出 上级(文本:a) {
    返回 目录(a)
}

# ── 名称 ──────────────────────────────────────────────────

导出 名称(文本:a) {
    变量 数组:片段 = a.strip("/").split("/")
    返回 片段[len(片段) - 1]
}

导出 文件名(文本:a) {
    变量 文本:最后 = 名称(a)
    变量 数字:位置 = 最后.rfind(".")
    如果(位置 <= 0) {
        返回 最后
    }
    返回 最后[:位置]
}

# ── 拓展 ──────────────────────────────────────────────────

导出 拓展(文本:a) {
    变量 文本:最后 = 名称(a)
    变量 数字:位置 = 最后.rfind(".")
    如果(位置 <= 0) {
        返回 ""
    }
    返回 最后[位置 + 1:]
}

导出 替换拓展(文本:a, 文本:新拓展) {
    变量 文本:最后 = 名称(a)
    变量 数字:位置 = 最后.rfind(".")
    如果(位置 <= 0) {
        返回 拼接(a, "." + 新拓展)
    }
    变量 文本:新名 = 最后[:位置] + "." + 新拓展
    返回 拼接(目录(a), 新名)
}

# ── 规范 ──────────────────────────────────────────────────

导出 规范(文本:a) {
    变量 数组:片段 = a.split("/")
    变量 数组:结果 = []
    变量 数字:序号 = 0
    循环(序号 < len(片段)) {
        变量 文本:片段值 = 片段[序号]
        如果(片段值 != "" and 片段值 != ".") {
            如果(片段值 == "..") {
                如果(len(结果) > 0) {
                    结果 = 结果[:len(结果) - 1]
                }
            } 或者(片段值 != "..") {
                结果 = 结果 + [片段值]
            }
        }
        序号++
    }
    变量 文本:开头 = ""
    如果(a.startswith("/")) {
        开头 = "/"
    }
    返回 开头 + "/".join(结果)
}

# ── 判断 ──────────────────────────────────────────────────

导出 绝对(文本:a) {
    如果(a.startswith("/")) {
        返回 真
    }
    返回 假
}

导出 存在(文本:a) {
    返回 路径存在(a)
}

导出 是文件(文本:a) {
    返回 路径是文件(a)
}

导出 是目录(文本:a) {
    返回 路径是目录(a)
}

# ── 拆分 ──────────────────────────────────────────────────

导出 分段(文本:a) {
    变量 数组:全部 = a.strip("/").split("/")
    如果(len(全部) == 1 and 全部[0] == "") {
        返回 []
    }
    返回 全部
}

导出 层级(文本:a) {
    返回 len(分段(a))
}

# ── 其他 ──────────────────────────────────────────────────

导出 大小(文本:a) {
    返回 路径大小(a)
}
